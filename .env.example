# ===================================================================
# Genius Abacus & Phonics — Class Management System
# Example environment file. Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# The real `.env` is gitignored and MUST NOT be committed. It holds
# secrets (database password, auth secret). This example file is safe
# to commit because it contains no real values.
# ===================================================================

# ---- Database (REQUIRED) ------------------------------------------
# PostgreSQL connection string used by Prisma (see prisma/schema.prisma).
# Must be a hosted/local PostgreSQL URL — never SQLite in production.
#
# Local development example:
#   postgresql://USER:PASSWORD@localhost:5432/genius_institute
#
# On Render this value is injected automatically from the managed
# database (render.yaml wires it via `fromDatabase → connectionString`),
# so you do NOT set it by hand there.
DATABASE_URL="postgresql://user:password@localhost:5432/genius_institute"

# ---- Authentication secret (RECOMMENDED) --------------------------
# A long, random, high-entropy string. Generate one with:
#   openssl rand -hex 32
# On Render this is generated automatically (render.yaml: generateValue: true).
# NEVER use a guessable value such as "secret", "password" or "123456".
AUTH_SECRET=""

# ---- Node environment ---------------------------------------------
# Render sets NODE_ENV=production automatically. Locally, leave this
# unset — `next dev` runs in development and `next start` in production.
# NODE_ENV="production"

# ---- Initial seed passwords (OPTIONAL) ----------------------------
# Used ONLY by `npx prisma db seed` when creating the first admin and
# teacher logins. If unset, the seed falls back to the documented
# defaults (Admin@123 / Teacher@123) which MUST be changed immediately
# after first login. For a production seed, set strong values here first.
# ADMIN_INITIAL_PASSWORD=""
# TEACHER_INITIAL_PASSWORD=""
